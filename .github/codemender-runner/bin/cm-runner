set -euo pipefail

# 1. Pick Python interpreter: explicit override -> active local venv -> container fallback -> system python3
if [ -n "${CM_RUNNER_PYTHON:-}" ]; then
    PYTHON="${CM_RUNNER_PYTHON}"
elif [ -n "${VIRTUAL_ENV:-}" ] && [ -x "${VIRTUAL_ENV}/bin/python3" ]; then
    PYTHON="${VIRTUAL_ENV}/bin/python3"
elif [ -x "/opt/codemender/venv/bin/python3" ]; then
    PYTHON="/opt/codemender/venv/bin/python3"
else
    PYTHON="python3"
fi

# 2. Locate package directory and set PYTHONPATH
if [ -d "/opt/codemender/codemender-runner" ]; then
    PKG_DIR="/opt/codemender/codemender-runner"
else
    SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "$0" 2>/dev/null || realpath "$0")")" && pwd)"
    PKG_DIR="$(cd "${SCRIPT_DIR}/.." && pwd)"
fi

export PYTHONPATH="${PKG_DIR}${PYTHONPATH:+:${PYTHONPATH}}"

# 3. Dispatch to directory execution (__main__.py)
exec "$PYTHON" "${PKG_DIR}" "$@"
